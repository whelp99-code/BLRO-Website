{
  "name": "blro-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.23.1 <23",
    "pnpm": ">=11.8.0 <12"
  },
  "packageManager": "pnpm@11.8.0",
  "scripts": {
    "dev": "next dev",
    "dev:grab": "react-grab --help",
    "dev:scan": "react-scan --help",
    "inspect:react": "react-doctor . --no-score --no-supply-chain --no-dead-code --blocking error -y",
    "build": "pnpm content:validate && next build",
    "deploy:preview": "wrangler pages deploy out --project-name blro-website --branch preview",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run --allowOnly=false --passWithNoTests=false",
    "test:unit": "vitest run --allowOnly=false --passWithNoTests=false tests/unit",
    "test:component": "vitest run --allowOnly=false --passWithNoTests=false tests/component",
    "test:integration": "vitest run --allowOnly=false --passWithNoTests=false tests/integration",
    "content:validate": "vitest run --allowOnly=false --passWithNoTests=false tests/unit/content-schema.test.ts tests/unit/content-publication.test.ts tests/unit/external-evidence.test.ts tests/integration/content-index.test.ts",
    "test:e2e": "playwright test",
    "test:policy": "node scripts/check-policy.mjs",
    "test:lighthouse": "lhci autorun",
    "audit:high": "pnpm audit --audit-level high",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "check": "pnpm lint && pnpm typecheck && pnpm test:policy && pnpm test:run && pnpm build",
    "check:release": "pnpm check && pnpm audit:high && pnpm test:e2e"
  },
  "dependencies": {
    "@mdx-js/mdx": "3.1.1",
    "gray-matter": "4.0.3",
    "next": "16.2.11",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.11",
    "jsdom": "29.1.1",
    "lighthouse": "13.4.0",
    "react-doctor": "0.7.6",
    "react-grab": "0.1.48",
    "react-scan": "0.5.7",
    "tailwindcss": "4.3.2",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "wrangler": "^4.110.0"
  }
}
