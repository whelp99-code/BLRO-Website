  "keyframesSample": [
    "@layer base {\n  :root, [data-theme=\"kumo\"] { --text-color-kumo-default: var(--color-neutral-900,oklch(21% .006 285.885)); --text-color-kumo-inverse: var(--color-neutral-100,oklch(97% 0 0)); --text-color-kumo-strong: var(--color-neutral-950,oklch(14.5% 0 0)); --text-color-kumo-sub",
    "@layer utilities {\n  .no-scrollbar::-webkit-scrollbar { display: none; }\n  .no-scrollbar { scrollbar-width: none; }\n  .no-input-spinner { appearance: textfield; }\n  .no-input-spinner ::-webkit-outer-spin-button { appearance: none; }\n  .no-input-spinner ::-webkit-inner-spin-button",
    "@keyframes right { \n  100% { transform: translate(100%); }\n}",
    ".float { animation: 5s linear 0s infinite alternate none running float; }",
    "@keyframes float { \n  0%, 100% { transform: translateY(0px); }\n  50% { transform: translateY(-8px); }\n}",
    "@keyframes refresh { \n  0% { transform: rotate(0deg); }\n  100% { transform: rotate(360deg); }\n}",
    "@keyframes bounce-in { \n  0% { opacity: 0; transform: scale(0.6); }\n  50% { opacity: 1; transform: scale(1.2); }\n  100% { transform: scale(1); }\n}",
    ".animate-bounce-in { animation: 0.4s ease-out 0s 1 normal none running bounce-in; }",
    "@keyframes shimmer { \n  0% { transform: translate(-100%); }\n  100% { transform: translate(100%); }\n}",
    ".kumo-chart-shimmer { transform-box: fill-box; animation: 1.8s ease-in-out 0s infinite normal none running shimmer; }",
    "@media (prefers-reduced-motion: reduce) {\n  .kumo-chart-shimmer { animation: auto ease 0s 1 normal none running none; transform: none; }\n}",
    "@keyframes toast-bump { \n  0% { transform: scale(1); }\n  20% { transform: scale(1.02); }\n  100% { transform: scale(1); }\n}",
    ".animate-toast-bump { transform-origin: 50% center; animation: 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) 0s 1 normal none running toast-bump; }",
    "@keyframes clipboard-toast-bump { \n  0% { transform: scale(1); }\n  35% { transform: scale(1.04); }\n  100% { transform: scale(1); }\n}",
    ".animate-clipboard-toast-bump { transform-origin: 50% center; animation: 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) 0s 1 normal none running clipboard-toast-bump; }",
    "@media (prefers-reduced-motion: reduce) {\n  .animate-clipboard-toast-bump { animation: auto ease 0s 1 normal none running none; }\n}",
    "@keyframes scroll-fade-x-left { \n  0% { --fade-left-n: 0; }\n  100% { --fade-left-n: 1; }\n}",
    "@keyframes scroll-fade-x-right { \n  0% { --fade-right-n: 1; }\n  100% { --fade-right-n: 0; }\n}"
  ],
  "scrollH": 7033
