# Local overrides. Production builds treat blank values as unset and use
# https://blro.co.kr, https://api.blro.co.kr, and the public Turnstile site key.
# A production SITE_URL of localhost or plain http is also replaced with https://blro.co.kr.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_LEAD_API_URL=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN=
